# =============================================
# TimeBlock 后端 API 服务 - 环境变量 (开发)
# =============================================

# 服务端口
PORT=3000

# 环境
NODE_ENV=development

# 数据库 (本地开发使用 SQLite)
DB_DIALECT=sqlite
DB_STORAGE=./data/timeblock.db

# MySQL 配置 (生产环境使用)
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=time_block
# DB_USER=root
# DB_PASSWORD=root

# JWT 认证
JWT_SECRET=timeblock-dev-secret-key
JWT_EXPIRES_IN=7d

# 限流
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
