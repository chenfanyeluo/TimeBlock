{
  "name": "timeblock",
  "version": "1.0.0",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:win": "npm run build && cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 electron-builder --win --x64",
    "build:mac": "npm run build && cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 electron-builder --mac",
    "build:linux": "npm run build && cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 electron-builder --linux"
  },
  "build": {
    "appId": "com.timeblock.app",
    "productName": "TimeBlock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/shared/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "src/assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "src/assets/timeblock_icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/timeblock_icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/timeblock_icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@element-plus/icons-vue": "^2.3.0",
    "dayjs": "^1.11.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.5.0",
    "pinia": "^2.1.0",
    "sql.js": "^1.14.1",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "sass": "^1.69.0",
    "vite": "^8.1.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
